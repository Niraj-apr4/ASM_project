
"""
# Arguments
- `L::Float`: length of full cv
- `H::Float`: Height of full cv
- `n::Integer`: number of differential cv
                more n more  finer the mesh is 
# Outputs
[points,nodes]
- `points::Array{Array{Float64}}`:
- `nodes::Array{Array{Float64}}`:

"""
function generate_2Dmesh(L,H,n,sx=1,sy=1)
    points = Array{Array{Float64}}(undef,n,n)

    # create the CV grid >>> 
    if sx == 1
        #unifrom
        x_array = range(0, L, n)  
    else
        # Geometric stretching
        x_array = [L * (sx^(i-1) - 1) / (sx^(n-1) - 1) for i in 1:n]
    end
    
    if sy == 1
        #uniform
        y_array = range(0, H, n) 
    else
        # Geometric stretching
        y_array = [H * (sy^(j-1) - 1) / (sy^(n-1) - 1) for j in 1:n]
    end

    x_array = range(0,L,n)
    y_array = range(0,H,n)
    for i = 1:n 
        for j = 1:n 
            points[i,j] = [x_array[i]*sx, y_array[j]*sy ,0]
        end
    end
    # now the points array consists of CV grids with initial temp u and v
    # assigned to be  0 

    # STEP 2 ##### 

    # Compute  computational nodes for each cv >>>
    nodes = Array{Array{Float64}}(undef,n-1,n-1)
    for i = 1:n-1 ,j = 1:n-1
        init_x = points[i,j][1]
        init_y = points[i,j][2]

        final_x = points[i+1,j][1]
        final_y = points[i,j+1][2]

        delta_x = final_x - init_x
        delta_y = final_y - init_y

        nodes[i,j] = [points[i,j][1] + delta_x/2 , points[i,j][2] +
            delta_y/2 , 0]
    end
    # <<<
    return[points,nodes]
end

struct LineSegment
    i::Int  # node index i
    j::Int  # node index j
    k::Float64  # spring constant
    c::Float64  # damping coefficient
    L0::Float64  # rest length
end

function create_grid_segments(points, k, c)
    n = size(points, 1)
    segments = LineSegment[]
    
    # Horizontal connections (along rows)
    for i in 1:n
        for j in 1:n-1
            p1 = points[i, j]
            p2 = points[i, j+1]
            L0 = norm(p2[1:2] - p1[1:2])  # rest length (use x,y only)
            
            # Store as flat indices for easier access
            
            idx1 = (i-1)*n + j
            idx2 = (i-1)*n + (j+1)
            
            push!(segments, LineSegment(idx1, idx2, k, c, L0))
        end
    end
    
    # vertical connections (along columns)
    for i in 1:n-1
        for j in 1:n
            p1 = points[i, j]
            p2 = points[i+1, j]
            L0 = norm(p2[1:2] - p1[1:2])
            
            idx1 = (i-1)*n + j
            idx2 = i*n + j
            
            push!(segments, LineSegment(idx1, idx2, k, c, L0))
        end
    end
    
    return segments
end
