include("plot_functions.jl")
include("mesh_geometry.jl")
using LinearAlgebra

######################
# STEP 1 create mesh # 
######################
n = 7 
L = 10 
H = 5 
sx = 1 
sy = 1 
points = generate_2Dmesh(L,H,n,sx,sy)

# properties for magnetoelastic fluid
K = 8
C = 8
Mass = 2.5

# calculate natural length
natural_length_x = norm(points[1,2][1:2]-points[1,1][1:2])
natural_length_y = norm(points[2,1][1:2]-points[1,1][1:2])

# ========== CHANGE 1: Add magnetic field parameters ==========
# Magnetic field strength (Tesla)
B_strength = 0.5

# Magnetization susceptibility (dimensionless, how material responds to field)
chi = 2.0

# Magnetic field frequency for time-varying actuation (Hz)
B_frequency = 1.0

# Direction of magnetic force: [x_direction, y_direction] normalized
# Example: [0, -1] means downward, [1, 0] means rightward
B_direction = [0.0, -1.0]  # Downward actuation
# ========== END CHANGE 1 ==========

function calculate_nodes!(i, j, dt, t)
    # ========== CHANGE 2: Added time parameter 't' to function ==========
    # This allows calculation of time-varying magnetic field
    # ========== END CHANGE 2 ==========
    
    global natural_length_x, K, C, Mass, natural_length_y
    global B_strength, chi, B_frequency, B_direction
    
    # current node
    p = points[i, j]
    pos_p = p[1:2]
    vel_p = p[3:4]
    accn_p = p[5:6]
    
    # Initialize deltas and velocities with defaults for boundary handling
    del_east = 0
    del_west = 0
    del_north = 0
    del_south = 0
    vel_east = vel_p
    vel_west = vel_p
    vel_north = vel_p
    vel_south = vel_p
    
    rows, cols = size(points)
    
    # Check and calculate for adjacent nodes (only if in bounds)
    if i + 1 <= rows
       p_east = points[i+1, j][1:2]
       del_east = norm(p_east - pos_p) - natural_length_y
       vel_east = points[i+1, j][3:4]
    end
    
    if i - 1 >= 1
        p_west = points[i-1, j][1:2]
        del_west = norm(p_west - pos_p) - natural_length_y
        vel_west = points[i-1, j][3:4]
    end
    
    if j + 1 <= cols
        p_north = points[i, j+1][1:2]
        del_north = norm(p_north - pos_p) - natural_length_x
        vel_north = points[i, j+1][3:4]
    end
    
    if j - 1 >= 1
        p_south = points[i, j-1][1:2]
        del_south = norm(p_south - pos_p) - natural_length_x
        vel_south = points[i, j-1][3:4]
    end
    
    # Calculate new acceleration in x direction
    new_acc_x = (K * del_east - K * del_west - C * (vel_east[1] - vel_p[1]) - 
                 C * (vel_p[1] - vel_west[1])) / Mass
    
    # Calculate new acceleration in y direction
    new_acc_y = (K * del_north - K * del_south - C * (vel_north[2] - vel_p[2]) - 
                 C * (vel_p[2] - vel_south[2])) / Mass
    
    # ========== CHANGE 3: Add magnetic force contribution ==========
    # Calculate time-varying magnetic field strength
    B_t = B_strength * sin(2 * π * B_frequency * t)
    
    # Calculate magnetic force: F_mag = chi * B^2 * B_direction
    # This assumes magnetization aligned with field direction
    F_mag_x = chi * B_t^2 * B_direction[1]
    F_mag_y = chi * B_t^2 * B_direction[2]
    
    # Add magnetic force to acceleration (divide by mass to get acceleration)
    new_acc_x += F_mag_x / Mass
    new_acc_y += F_mag_y / Mass
    # ========== END CHANGE 3 ==========
    
    # Update velocity and position
    new_vel_x = vel_p[1] + new_acc_x * dt
    new_pos_x = pos_p[1] + new_vel_x * dt
    
    new_vel_y = vel_p[2] + new_acc_y * dt
    new_pos_y = pos_p[2] + new_vel_y * dt
    
    # Update node state
    points[i, j] = [new_pos_x, new_pos_y, new_vel_x, new_vel_y, 
                    new_acc_x, new_acc_y]
end

function apply_fixed_left_boundary!()
    rows, cols = size(points)
    for j in 1:cols
        x_fixed = points[1, j][1]
        y_fixed = points[1, j][2]
        points[1, j] = [x_fixed, y_fixed, 0.0, 0.0, 0.0, 0.0]
    end
end

######################
# INITIAL CONDITIONS #
######################
# Apply small displacement to right-end bottom node
points[end, 1][2] = points[end, 1][2] + 0.5  # Downward displacement of 0.5 units

# Apply small initial velocity to create motion
points[end, 1][4] = 1.0  # Initial y-velocity

# Freeze left boundary
apply_fixed_left_boundary!()

######################
# SIMULATION LOOP    #
######################
dt = 0.01
num_steps = 500
t = 0.0  # ========== CHANGE 4: Initialize time variable ==========

for step in 1:num_steps
    # ========== CHANGE 5: Pass current time 't' to calculate_nodes! ==========
    for i = 2:n, j = 1:n
        calculate_nodes!(i, j, dt, t)
    end
    # ========== END CHANGE 5 ==========
    
    apply_fixed_left_boundary!()
    
    # ========== CHANGE 6: Increment time at each step ==========
    t += dt
    # ========== END CHANGE 6 ==========
    
    # Print progress every 50 steps
    if mod(step, 50) == 0
        println("Step $step / $num_steps, Time: $t s, B(t): $(0.5 * sin(2 * π * 1.0 * t))")
    end
end

println("Simulation complete!")
println("Final magnetic parameters used:")
println("  B_strength: $B_strength")
println("  chi (susceptibility): $chi")
println("  B_frequency: $B_frequency Hz")
println("  B_direction: $B_direction")
